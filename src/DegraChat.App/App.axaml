<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:DegraChat.App.Converters"
             x:Class="DegraChat.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />

        <!-- ===== GLOBAL DARK THEME OVERRIDES ===== -->

        <!-- Window -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="#F4F4F4"/>
        </Style>

        <!-- Border -->
        <Style Selector="Border">
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <!-- TextBlock defaults -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
        </Style>

        <!-- ===== BUTTON STYLES ===== -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button:PointerOver">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="#EEE"/>
        </Style>
        <Style Selector="Button:Pressed">
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
        <Style Selector="Button:Disabled">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="BorderBrush" Value="#222"/>
        </Style>

        <!-- Accent Button (class=accent) -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#00C896"/>
            <Setter Property="Foreground" Value="#111"/>
            <Setter Property="BorderBrush" Value="#00C896"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:PointerOver">
            <Setter Property="Background" Value="#00DDAA"/>
            <Setter Property="Foreground" Value="#111"/>
        </Style>
        <Style Selector="Button.accent:Pressed">
            <Setter Property="Background" Value="#00AA7C"/>
        </Style>

        <!-- Ghost Button (class=ghost) -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.ghost:PointerOver">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCC"/>
        </Style>

        <!-- Danger Button -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#FF5C5C"/>
            <Setter Property="Foreground" Value="#111"/>
            <Setter Property="BorderBrush" Value="#FF5C5C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.danger:PointerOver">
            <Setter Property="Background" Value="#FF7777"/>
        </Style>

        <!-- ===== TEXTBOX STYLES ===== -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CaretBrush" Value="#00C896"/>
        </Style>
        <Style Selector="TextBox:FocusWithin">
            <Setter Property="BorderBrush" Value="#00C896"/>
        </Style>
        <Style Selector="TextBox:PointerOver">
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
        <Style Selector="TextBox /template/ TextBlock#PlaceholderText">
            <Setter Property="Foreground" Value="#555"/>
        </Style>

        <!-- ===== CHECKBOX STYLES ===== -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="CheckBox:PointerOver /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="#555"/>
        </Style>
        <Style Selector="CheckBox:IsChecked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#00C896"/>
            <Setter Property="BorderBrush" Value="#00C896"/>
        </Style>
        <Style Selector="CheckBox:IsChecked">
            <Setter Property="Foreground" Value="#CCC"/>
        </Style>

        <!-- ===== COMBOBOX STYLES ===== -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ComboBox:PointerOver">
            <Setter Property="BorderBrush" Value="#444"/>
        </Style>
        <Style Selector="ComboBox:Open">
            <Setter Property="BorderBrush" Value="#00C896"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="ComboBoxItem:PointerOver">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        <Style Selector="ComboBoxItem:IsSelected">
            <Setter Property="Background" Value="#00C89615"/>
            <Setter Property="Foreground" Value="#00C896"/>
        </Style>

        <!-- ===== TOGGLESWITCH STYLES ===== -->
        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="#999"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="ToggleSwitch:IsChecked /template/ Border#SwitchTrack">
            <Setter Property="Background" Value="#00C896"/>
        </Style>

        <!-- ===== SLIDER STYLES ===== -->
        <Style Selector="Slider">
            <Setter Property="Foreground" Value="#00C896"/>
        </Style>
        <Style Selector="Slider /template/ Border#TrackBackground">
            <Setter Property="Background" Value="#333"/>
        </Style>
        <Style Selector="Slider /template/ Border#TrackFill">
            <Setter Property="Background" Value="#00C896"/>
        </Style>

        <!-- ===== LISTBOX STYLES ===== -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
        <Style Selector="ListBoxItem:PointerOver">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        <Style Selector="ListBoxItem:IsSelected">
            <Setter Property="Background" Value="#00C89615"/>
            <Setter Property="Foreground" Value="#00C896"/>
        </Style>

        <!-- ===== SCROLLVIEWER ===== -->
        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Scrollbar (compact dark) -->
        <Style Selector="ScrollBar">
            <Setter Property="Foreground" Value="#444"/>
        </Style>
        <Style Selector="ScrollBar:Vertical /template/ Border#Root /template/ RepeatButton#LineUpButton">
            <Setter Property="Height" Value="0"/>
        </Style>
        <Style Selector="ScrollBar:Vertical /template/ Border#Root /template/ RepeatButton#LineDownButton">
            <Setter Property="Height" Value="0"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#444"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb:PointerOver">
            <Setter Property="Background" Value="#666"/>
        </Style>

        <!-- ===== TOOLTIP ===== -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <!-- ===== DOCKPANEL / PANEL ===== -->
        <Style Selector="DockPanel">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Panel">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===== ITEMS CONTROL ===== -->
        <Style Selector="ItemsControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- ===== ELLIPSE DEFAULT ===== -->
        <!-- (no override needed — Fill is set inline) -->

        <!-- ===== CONTEXT MENU ===== -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="MenuItem:PointerOver">
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>

        <!-- ===== EXPANDER ===== -->
        <Style Selector="Expander">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- ===== TAB CONTROL ===== -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

    </Application.Styles>

    <Application.Resources>
        <!-- DegraChat Color Scheme -->
        <SolidColorBrush x:Key="AppBackground">#151515</SolidColorBrush>
        <SolidColorBrush x:Key="PanelBackground">#1A1A1A</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrush">#00C896</SolidColorBrush>
        <SolidColorBrush x:Key="WarningBrush">#FFB84D</SolidColorBrush>
        <SolidColorBrush x:Key="ErrorBrush">#FF5C5C</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimary">#F4F4F4</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#B0B0B0</SolidColorBrush>
        <SolidColorBrush x:Key="TextMuted">#777777</SolidColorBrush>
        <SolidColorBrush x:Key="ElevatedBackground">#222222</SolidColorBrush>
        <SolidColorBrush x:Key="HoverBackground">#2A2A2A</SolidColorBrush>
        <SolidColorBrush x:Key="BorderBrush">#333333</SolidColorBrush>
        <SolidColorBrush x:Key="BorderSubtleBrush">#2A2A2A</SolidColorBrush>

        <!-- Platform Colors -->
        <SolidColorBrush x:Key="TwitchBrush">#9146FF</SolidColorBrush>
        <SolidColorBrush x:Key="GoodGameBrush">#00CC00</SolidColorBrush>
        <SolidColorBrush x:Key="KickBrush">#53FC18</SolidColorBrush>
        <SolidColorBrush x:Key="VKPlayBrush">#0077FF</SolidColorBrush>
        <SolidColorBrush x:Key="YouTubeBrush">#FF0000</SolidColorBrush>

        <!-- Converters -->
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
        <converters:EnumNotEqualsConverter x:Key="EnumNotEqualsConverter" />
        <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
        <converters:FirstCharConverter x:Key="FirstCharConverter" />
        <converters:ConnectionStateToColorConverter x:Key="StateToColorConverter" />
        <converters:ConnectionStateToStringConverter x:Key="StateToStringConverter" />
        <converters:PlatformToColorConverter x:Key="PlatformToColorConverter" />
    </Application.Resources>
</Application>
